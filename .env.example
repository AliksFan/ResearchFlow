# Template only. Use only disposable local data and newly generated secrets.
# Placeholder values are intentionally not usable credentials.
NODE_ENV=development
APP_TIMEZONE=UTC
NEXTAUTH_URL=https://localhost:3443
PUBLIC_BASE_URL=https://localhost:3443
DATABASE_URL=postgresql://demo_user:REPLACE_WITH_LOCAL_PASSWORD@127.0.0.1:5432/researchflow_demo?schema=portfolio_demo
NEXTAUTH_SECRET=PLACEHOLDER_GENERATE_NEW_LOCAL_RANDOM_SECRET
AUTH_HMAC_SECRET=PLACEHOLDER_GENERATE_NEW_LOCAL_RANDOM_SECRET
AUTH_TRUST_PROXY_HEADERS=0
INITIAL_PMO_PASSWORD=
EXPECTED_PRISMA_MIGRATION_COUNT=25
# Optional local S3-compatible storage must be provisioned separately.
ATTACHMENT_S3_ENDPOINT=http://127.0.0.1:9000
ATTACHMENT_S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
ATTACHMENT_S3_REGION=us-east-1
ATTACHMENT_S3_BUCKET=researchflow-demo
ATTACHMENT_S3_ACCESS_KEY_ID=PLACEHOLDER_LOCAL_STORAGE_KEY
ATTACHMENT_S3_SECRET_ACCESS_KEY=PLACEHOLDER_LOCAL_STORAGE_SECRET
ATTACHMENT_CLEANUP_ENABLED=0
NOTIFICATION_WORKER_ENABLED=0
NOTIFICATION_TRANSPORT=capture