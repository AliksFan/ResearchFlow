model Person {
  id                                      String                               @id @default(uuid()) @db.Uuid
  employeeNo                              String?                              @unique @map("employee_no")
  displayName                             String                               @map("display_name")
  loginName                               String                               @unique @map("login_name")
  workEmail                               String?                              @unique @map("work_email")
  mobile                                  String?
  passwordHash                            String?                              @map("password_hash")
  departmentName                          String?                              @map("department_name")
  accountStatus                           AccountStatus                        @default(INVITED) @map("account_status")
  mustChangePassword                      Boolean                              @default(true) @map("must_change_password")
  failedLoginCount                        Int                                  @default(0) @map("failed_login_count")
  failedLoginWindowStartedAt              DateTime?                            @map("failed_login_window_started_at") @db.Timestamptz(3)
  lockedUntil                             DateTime?                            @map("locked_until") @db.Timestamptz(3)
  passwordChangedAt                       DateTime?                            @map("password_changed_at") @db.Timestamptz(3)
  lastLoginAt                             DateTime?                            @map("last_login_at") @db.Timestamptz(3)
  createdAt                               DateTime                             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                               DateTime                             @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions                                Session[]
  credentialTokens                        AuthCredentialToken[]
  passwordHistory                         PasswordHistory[]
  roleAssignments                         RoleAssignment[]                     @relation("RoleAssignmentPerson")
  roleAssignmentsGranted                  RoleAssignment[]                     @relation("RoleAssignmentGrantor")
  roleEligibilities                       RoleEligibility[]                    @relation("RoleEligibilityPerson")
  roleEligibilitiesGranted                RoleEligibility[]                    @relation("RoleEligibilityGrantor")
  roleEligibilitiesEnded                  RoleEligibility[]                    @relation("RoleEligibilityEnder")
  appliedProjects                         Project[]                            @relation("ProjectApplicant")
  establishedProjects                     Project[]                            @relation("ProjectEstablisher")
  cancelledProjects                       Project[]                            @relation("ProjectCanceller")
  establishmentSubmissions                ProjectEstablishmentReview[]         @relation("EstablishmentSubmitter")
  establishmentReviews                    ProjectEstablishmentReview[]         @relation("EstablishmentReviewer")
  applicationVersionsCreated              ProjectApplicationVersion[]
  proposedApplicationOwnerships           ProjectApplicationVersionOwner[]
  projectApplicationActivities            ProjectApplicationActivity[]
  projectApplicationCommands              ProjectApplicationCommand[]
  completionActivities                    ProjectCompletionActivity[]
  primaryKeySubIChanges                   ProjectPrimaryKeySubIChange[]
  fieldChangeRequests                     ProjectFieldChangeRequest[]
  fieldChangeActivities                   ProjectFieldChangeActivity[]
  governanceSettingsUpdated               ProjectGovernanceSetting[]
  templateVersionsPublished               LifecycleTemplateVersion[]
  planVersionsCreated                     ProjectPlanVersion[]
  planChangeRequests                      ProjectPlanChangeRequest[]
  planChangeActivities                    ProjectPlanChangeActivity[]
  reminderSettingsUpdated                 ProjectReminderSetting[]
  workflowUpdates                         WorkflowUpdate[]
  issuesReported                          Issue[]                              @relation("IssueReporter")
  issuesResolved                          Issue[]                              @relation("IssueResolver")
  issueStatesRequired                     IssueHandlingState[]                 @relation("IssueStateRequiredPerson")
  issueStatesEntered                      IssueHandlingState[]                 @relation("IssueStateEnteredBy")
  issueConfirmationSettingsUpdated        IssueConfirmationSetting[]
  issueActivities                         IssueActivity[]
  issueEmailsSent                         IssueEmail[]
  issueEmailRecipients                    IssueEmailRecipient[]
  notificationsReceived                   Notification[]                       @relation("NotificationRecipient")
  notificationsTriggered                  Notification[]                       @relation("NotificationTrigger")
  auditLogs                               AuditLog[]
  dictionarySuggestionsReviewed           DictionaryOptionSuggestion[]         @relation("DictionarySuggestionReviewer")
  dictionarySuggestionSourcesSubmitted    DictionaryOptionSuggestionSource[]   @relation("DictionarySuggestionSubmitter")
  exportJobs                              ExportJob[]
  projectCompletionSubmissions            ProjectCompletionSubmissionVersion[]
  projectCompletionReviewsCompleted       ProjectCompletionReviewRound[]
  projectCompletionSupplementsResponsible ProjectCompletionSupplementRound[]
  projectArchiveActivities                ProjectArchiveActivity[]
  workflowUpdateCorrections               WorkflowUpdateCorrection[]
  workflowCompletionSubmissions           WorkflowCompletionSubmission[]
  workflowCompletionSupplements           WorkflowCompletionSupplement[]
  workflowCompletionReviewsCompleted      WorkflowCompletionReviewRound[]
  workflowCompletionActivities            WorkflowCompletionActivity[]
  issueDeanDecisions                      IssueDeanDecision[]
  issueImplementationSubmissions          IssueImplementationSubmission[]
  issueImplementationReviews              IssueImplementationReview[]
  issueReviewTransfersFromDean            IssueDeanReviewTransfer[]            @relation("IssueReviewTransferFromDean")
  issueReviewTransfersRequested           IssueDeanReviewTransfer[]            @relation("IssueReviewTransferRequester")
  issueReviewTransfersAccepted            IssueDeanReviewTransfer[]            @relation("IssueReviewTransferAcceptedDean")
  issueSharedSummaries                    IssueSharedSummary[]
  collaborationTimeLimitsUpdated          CollaborationTimeLimitSetting[]
  notificationOutboxes                    NotificationOutbox[]
  attachmentDrafts                        AttachmentDraft[]
  attachmentUploadSessions                AttachmentUploadSession[]
  fileAssetsUploaded                      FileAsset[]
  businessAttachmentsAdded                BusinessAttachment[]

  @@index([accountStatus])
  @@map("person")
}

model AuthCredentialToken {
  id         String                 @id @default(uuid()) @db.Uuid
  personId   String                 @map("person_id") @db.Uuid
  purpose    CredentialTokenPurpose
  tokenHash  String                 @unique @map("token_hash")
  expiresAt  DateTime               @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime?              @map("consumed_at") @db.Timestamptz(3)
  revokedAt  DateTime?              @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  person     Person                 @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([personId, purpose, expiresAt])
  @@index([expiresAt])
  @@map("auth_credential_token")
}

model PasswordHistory {
  id           String   @id @default(uuid()) @db.Uuid
  personId     String   @map("person_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  person       Person   @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([personId, createdAt])
  @@map("password_history")
}

model AuthRateLimit {
  id              String                 @id @default(uuid()) @db.Uuid
  dimension       AuthRateLimitDimension
  keyHash         String                 @map("key_hash")
  failureCount    Int                    @default(0) @map("failure_count")
  windowStartedAt DateTime?              @map("window_started_at") @db.Timestamptz(3)
  lockedUntil     DateTime?              @map("locked_until") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([dimension, keyHash])
  @@index([lockedUntil])
  @@map("auth_rate_limit")
}

model Session {
  id             String     @id @default(uuid()) @db.Uuid
  personId       String     @map("person_id") @db.Uuid
  tokenHash      String     @unique @map("token_hash")
  activeRoleCode RoleCode?  @map("active_role_code")
  expiresAt      DateTime   @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime?  @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt     DateTime   @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  person         Person     @relation(fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  auditLogs      AuditLog[]

  @@index([personId, expiresAt])
  @@map("session")
}

model RoleAssignment {
  id                     String                        @id @default(uuid()) @db.Uuid
  personId               String                        @map("person_id") @db.Uuid
  roleCode               RoleCode                      @map("role_code")
  projectId              String?                       @map("project_id") @db.Uuid
  assignmentStatus       AssignmentStatus              @default(PROPOSED) @map("assignment_status")
  isPrimary              Boolean                       @default(false) @map("is_primary")
  grantSource            RoleAssignmentGrantSource     @default(PMO_ACTION) @map("grant_source")
  grantedByPersonId      String?                       @map("granted_by_person_id") @db.Uuid
  proposedAt             DateTime                      @default(now()) @map("proposed_at") @db.Timestamptz(3)
  activatedAt            DateTime?                     @map("activated_at") @db.Timestamptz(3)
  endedAt                DateTime?                     @map("ended_at") @db.Timestamptz(3)
  person                 Person                        @relation("RoleAssignmentPerson", fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  project                Project?                      @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedBy              Person?                       @relation("RoleAssignmentGrantor", fields: [grantedByPersonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  previousPrimaryChanges ProjectPrimaryKeySubIChange[] @relation("PreviousPrimaryAssignment")
  newPrimaryChanges      ProjectPrimaryKeySubIChange[] @relation("NewPrimaryAssignment")

  @@unique([projectId, id])
  @@index([personId, assignmentStatus])
  @@index([projectId, roleCode, assignmentStatus])
  @@map("role_assignment")
}

model RoleEligibility {
  id                String                @id @default(uuid()) @db.Uuid
  personId          String                @map("person_id") @db.Uuid
  roleCode          RoleCode              @default(KEY_SUB_I) @map("role_code")
  status            RoleEligibilityStatus @default(ACTIVE)
  grantedByPersonId String                @map("granted_by_person_id") @db.Uuid
  grantedAt         DateTime              @default(now()) @map("granted_at") @db.Timestamptz(3)
  endedByPersonId   String?               @map("ended_by_person_id") @db.Uuid
  endedAt           DateTime?             @map("ended_at") @db.Timestamptz(3)
  reason            String
  person            Person                @relation("RoleEligibilityPerson", fields: [personId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  grantedBy         Person                @relation("RoleEligibilityGrantor", fields: [grantedByPersonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  endedBy           Person?               @relation("RoleEligibilityEnder", fields: [endedByPersonId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([personId, roleCode, status])
  @@map("role_eligibility")
}

