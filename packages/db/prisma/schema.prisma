model Dictionary {
  id             String                       @id @default(uuid()) @db.Uuid
  dictionaryCode String                       @unique @map("dictionary_code")
  dictionaryName String                       @map("dictionary_name")
  description    String
  enabled        Boolean                      @default(true)
  createdAt      DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  options        DictionaryOption[]
  suggestions    DictionaryOptionSuggestion[]

  @@unique([id, dictionaryCode])
  @@map("dictionary")
}

model DictionaryOption {
  id                                String                       @id @default(uuid()) @db.Uuid
  dictionaryId                      String                       @map("dictionary_id") @db.Uuid
  dictionaryCode                    String                       @map("dictionary_code")
  optionCode                        String                       @map("option_code")
  displayName                       String                       @map("display_name")
  sortOrder                         Int                          @default(0) @map("sort_order")
  enabled                           Boolean                      @default(true)
  createdAt                         DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt                         DateTime                     @updatedAt @map("updated_at") @db.Timestamptz(3)
  dictionary                        Dictionary                   @relation(fields: [dictionaryId, dictionaryCode], references: [id, dictionaryCode], onDelete: Restrict, onUpdate: Restrict)
  projectsByDiseaseArea             Project[]                    @relation("ProjectDiseaseArea")
  projectsByResearchType            Project[]                    @relation("ProjectResearchType")
  applicationVersionsByDiseaseArea  ProjectApplicationVersion[]  @relation("ApplicationVersionDiseaseArea")
  applicationVersionsByResearchType ProjectApplicationVersion[]  @relation("ApplicationVersionResearchType")
  fieldChangeItemsOld               ProjectFieldChangeItem[]     @relation("FieldChangeOldOption")
  fieldChangeItemsNew               ProjectFieldChangeItem[]     @relation("FieldChangeNewOption")
  issuesByType                      Issue[]                      @relation("IssueType")
  issueActivitiesFromType           IssueActivity[]              @relation("IssueActivityFromType")
  issueActivitiesToType             IssueActivity[]              @relation("IssueActivityToType")
  suggestionTargets                 DictionaryOptionSuggestion[] @relation("DictionarySuggestionTarget")

  @@unique([dictionaryCode, id])
  @@unique([dictionaryCode, optionCode])
  @@index([dictionaryId, enabled, sortOrder])
  @@map("dictionary_option")
}

model DictionaryOptionSuggestion {
  id                  String                             @id @default(uuid()) @db.Uuid
  dictionaryCode      String                             @map("dictionary_code")
  proposedDisplayName String                             @map("proposed_display_name")
  normalizedName      String                             @map("normalized_name")
  status              DictionaryOptionSuggestionStatus   @default(PENDING)
  targetOptionId      String?                            @map("target_option_id") @db.Uuid
  reviewedByPersonId  String?                            @map("reviewed_by_person_id") @db.Uuid
  reviewedAt          DateTime?                          @map("reviewed_at") @db.Timestamptz(3)
  reviewComment       String?                            @map("review_comment")
  rowVersion          Int                                @default(0) @map("row_version")
  createdAt           DateTime                           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime                           @updatedAt @map("updated_at") @db.Timestamptz(3)
  dictionary          Dictionary                         @relation(fields: [dictionaryCode], references: [dictionaryCode], onDelete: Restrict, onUpdate: Restrict)
  targetOption        DictionaryOption?                  @relation("DictionarySuggestionTarget", fields: [dictionaryCode, targetOptionId], references: [dictionaryCode, id], onDelete: Restrict, onUpdate: Restrict)
  reviewedBy          Person?                            @relation("DictionarySuggestionReviewer", fields: [reviewedByPersonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sources             DictionaryOptionSuggestionSource[]

  @@unique([dictionaryCode, normalizedName], map: "dictionary_suggestion_name_key")
  @@index([dictionaryCode, status, createdAt], map: "dictionary_suggestion_status_idx")
  @@map("dictionary_option_suggestion")
}

model DictionaryOptionSuggestionSource {
  id                   String                     @id @default(uuid()) @db.Uuid
  suggestionId         String                     @map("suggestion_id") @db.Uuid
  applicationVersionId String?                    @map("application_version_id") @db.Uuid
  issueId              String?                    @map("issue_id") @db.Uuid
  fieldCode            String                     @map("field_code")
  submittedByPersonId  String                     @map("submitted_by_person_id") @db.Uuid
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)
  suggestion           DictionaryOptionSuggestion @relation(fields: [suggestionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  applicationVersion   ProjectApplicationVersion? @relation(fields: [applicationVersionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  issue                Issue?                     @relation(fields: [issueId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  submittedBy          Person                     @relation("DictionarySuggestionSubmitter", fields: [submittedByPersonId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([suggestionId, createdAt], map: "dictionary_suggestion_source_suggestion_idx")
  @@map("dictionary_option_suggestion_source")
}

model AuditLog {
