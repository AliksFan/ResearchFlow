  attachmentUploadSession   AttachmentUploadSession  @relation(fields: [projectId, attachmentUploadSessionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  uploadedBy                Person                   @relation(fields: [uploadedByPersonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  businessAttachment        BusinessAttachment?

  @@unique([projectId, id])
  @@index([attachmentUploadSessionId, status])
  @@index([cleanupNextAttemptAt, cleanupLeaseExpiresAt])
  @@map("file_asset")
}

model BusinessAttachment {
