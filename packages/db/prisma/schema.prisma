  projectCompletionSubmissionVersionId String?                             @map("project_completion_submission_version_id") @db.Uuid
  project                              Project                             @relation(fields: [projectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fileAsset                            FileAsset                           @relation(fields: [projectId, fileAssetId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  attachedBy                           Person                              @relation(fields: [attachedByPersonId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  workflowUpdate                       WorkflowUpdate?                     @relation(fields: [projectId, workflowUpdateId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  workflowCompletionSubmission         WorkflowCompletionSubmission?       @relation(fields: [projectId, workflowCompletionSubmissionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  workflowCompletionSupplement         WorkflowCompletionSupplement?       @relation(fields: [projectId, workflowCompletionSupplementId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  issue                                Issue?                              @relation(fields: [projectId, issueId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  issueActivity                        IssueActivity?                      @relation(fields: [projectId, issueId, issueActivityId], references: [projectId, issueId, id], onDelete: Restrict, onUpdate: Restrict)
  issueDeanDecision                    IssueDeanDecision?                  @relation(fields: [projectId, issueDeanDecisionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  issueImplementationSubmission        IssueImplementationSubmission?      @relation(fields: [projectId, issueImplementationSubmissionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  projectPlanChangeRequest             ProjectPlanChangeRequest?           @relation(fields: [projectId, projectPlanChangeRequestId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  projectPlanChangeActivity            ProjectPlanChangeActivity?          @relation(fields: [projectPlanChangeRequestId, projectPlanChangeActivityId], references: [requestId, id], onDelete: Restrict, onUpdate: Restrict)
  projectFieldChangeRequest            ProjectFieldChangeRequest?          @relation(fields: [projectId, projectFieldChangeRequestId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)
  projectFieldChangeActivity           ProjectFieldChangeActivity?         @relation(fields: [projectFieldChangeRequestId, projectFieldChangeActivityId], references: [requestId, id], onDelete: Restrict, onUpdate: Restrict)
  projectCompletionSubmissionVersion   ProjectCompletionSubmissionVersion? @relation(fields: [projectId, projectCompletionSubmissionVersionId], references: [projectId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([projectId, id])
  @@unique([projectId, fileAssetId])
  @@index([workflowUpdateId])
  @@index([workflowCompletionSubmissionId])
  @@index([issueId])
  @@index([projectCompletionSubmissionVersionId])
  @@map("business_attachment")
