  actorPersonId         String?          @map("actor_person_id") @db.Uuid
  actorRoleCode         RoleCode?        @map("actor_role_code")
  sessionId             String?          @map("session_id") @db.Uuid
  actorIdentifierMasked String?          @map("actor_identifier_masked")
  actionCode            String           @map("action_code")
  result                AuditResult
  projectId             String?          @map("project_id") @db.Uuid
  entityType            String           @map("entity_type")
  entityId              String?          @map("entity_id") @db.Uuid
  entityBusinessCode    String?          @map("entity_business_code")
  summary               String
  changedFields         String[]         @default([]) @map("changed_fields")
  beforeSnapshot        Json?            @map("before_snapshot")
  afterSnapshot         Json?            @map("after_snapshot")
