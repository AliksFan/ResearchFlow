  establishmentReviews             ProjectEstablishmentReview[]
  completionRequests               ProjectCompletionRequest[]
  completionActivities             ProjectCompletionActivity[]
  primaryKeySubIChanges            ProjectPrimaryKeySubIChange[]
  fieldChangeRequests              ProjectFieldChangeRequest[]
  projectPlan                      ProjectPlan?
  reminderSetting                  ProjectReminderSetting?
  planChangeRequests               ProjectPlanChangeRequest[]
  stages                           ProjectStage[]
