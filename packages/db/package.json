{
  "name": "@researchflow/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "prisma": "prisma",
    "build": "prisma generate",
    "lint": "prisma validate && eslint src tests scripts/seed-default-pmo.ts scripts/seed-project-application-e2e.ts scripts/reference-data.ts",
    "typecheck": "prisma validate && tsc --noEmit",
    "test": "prisma validate && node scripts/validate-schema-contract.mjs && node scripts/validate-data-access-boundary.mjs && node scripts/validate-log-redaction.mjs && node scripts/validate-patient-data-ban.mjs && vitest run --passWithNoTests --exclude tests/integration/**",
    "test:database": "node scripts/validate-migration-database.mjs",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "seed:default-pmo": "jiti scripts/seed-default-pmo.ts",
    "seed:project-application-e2e": "jiti scripts/seed-project-application-e2e.ts",
    "reference-data:check": "jiti scripts/reference-data.ts"
  },
  "dependencies": {
    "@researchflow/attachments": "workspace:*",
    "@researchflow/auth": "workspace:*",
    "@researchflow/collaboration": "workspace:*",
    "@researchflow/project-application": "workspace:*",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.3",
    "eslint": "9.39.5",
    "jiti": "2.7.0",
    "prisma": "7.8.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}